{
  "name": "money-manager",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "vitest run",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust.ps1 -Task test",
    "check": "npm run build && npm run test",
    "test:e2e": "playwright test",
    "desktop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust.ps1 -Task desktop",
    "types": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust.ps1 -Task types",
    "test:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
